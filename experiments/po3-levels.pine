//@version=6
//+------------------------------------------------------------------+
//|                                                PO3_Levels.pine   |
//|                                                                  |
//|  TradingView port of experiments/po3-levels.mq5 (v1.54), the     |
//|  single-indicator build that carries:                            |
//|                                                                  |
//|    * PO3 (power of three) support/resistance levels, every grid  |
//|      from 1 to 19683. A price is owned by the HIGHEST power of   |
//|      three that lands on it and is labelled with that number, so |
//|      the bigger numbers read as the stronger levels;             |
//|    * Ichimoku kihon suchi candle counts, marked on the chart and |
//|      carried in a ladder panel (year / month / week / day);      |
//|    * the kihon segment panel - the finer counts taken inside an  |
//|      H4 or H1 candle that is itself on a kihon number;           |
//|    * the kihon schedule panel - when this week's kihon candles   |
//|      open, and which of today's are still in front;              |
//|    * unraided liquidity - swing highs and lows price has not yet |
//|      traded through, drawn from the wick to the right edge;      |
//|    * unmitigated fair value gaps - three-candle imbalances not   |
//|      yet filled, shaded from the middle candle to the right;     |
//|    * the candle countdown and the session timer.                 |
//|                                                                  |
//|  The arithmetic, the inclusive counting rule (candle 1 is the    |
//|  candle at the anchor, so k spans share a turning candle and     |
//|  17 + 17 - 1 = 33) and the level-ownership rule are ported       |
//|  unchanged from the MQL5 file. They are the parts the EAs in     |
//|  this repo also use, so the chart, the EAs and the .mq5 must     |
//|  agree on what "on a kihon number" means.                        |
//|                                                                  |
//|  WHERE PINE FORCES A DIFFERENCE (all of them display only - no   |
//|  number and no rule is changed):                                 |
//|                                                                  |
//|    1. No buttons. The three kihon blocks are switched by the     |
//|       inputs instead, and the segment block still opens by       |
//|       itself while an H4 / H1 kihon candle runs (the auto input  |
//|       in its own group).                                         |
//|    2. No timer. Pine recomputes on a tick, so the countdown and  |
//|       the session clock stop between ticks on a quiet market.    |
//|       The panel refreshes once a minute (it cannot change any    |
//|       faster) and on every new bar.                              |
//|    3. No z-order. Lines and labels always sit above the candles; |
//|       "draw the grid behind the candles" has nothing to act on.  |
//|    4. No font choice and no pixel offsets. Label sizes are       |
//|       TradingView's five steps, and the panels are pinned to one |
//|       of the nine chart corners rather than to an X/Y.           |
//|    5. The session clock restarts when the script is recompiled   |
//|       or its inputs change - Pine has no terminal global to park |
//|       it in across a reload, so the MQL5 "survives a timeframe   |
//|       change" behaviour cannot be reproduced.                    |
//|    6. The schedule panel reads a real IANA timezone (default     |
//|       Pacific/Port_Moresby, +10) rather than a fixed UTC offset, |
//|       which is strictly better: it survives DST on both sides.   |
//|    7. The 500-object cap. TradingView keeps the 500 most recent  |
//|       labels, lines and boxes, so "number every candle" plus all |
//|       three panels plus the grids can clip the oldest of them.   |
//|    8. The liquidity and fair-value-gap scans follow the chart     |
//|       timeframe only. The .mq5 can lock them to another one;     |
//|       Pine cannot walk another timeframe's bars newest to oldest, |
//|       and every substitute changes the liquidity tie rule. This  |
//|       is the .mq5's default (current = follow the chart).        |
//+------------------------------------------------------------------+
indicator("PO3 Levels + Kihon Suchi", "PO3", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500,
     max_bars_back = 2000)

//+------------------------------------------------------------------+
//|  KIHON SUCHI - Ichimoku's basic time numbers.                    |
//|                                                                  |
//|  The simple numbers are 9, 17 and 26; the compound ones chain    |
//|  spans that share a candle, so k spans subtract k-1. 26 is the   |
//|  one given number rather than a result, and the list stops where |
//|  the classical one stops - above 257 nothing on an intraday      |
//|  chart can reach the next number.                                |
//|                                                                  |
//|  These are candidate turning points in TIME, not in price, and   |
//|  they say nothing about direction. A kihon candle landing on a   |
//|  27 or an 81 level is time and price agreeing, which is the only |
//|  reason the two halves of this script sit in one file.           |
//+------------------------------------------------------------------+
KIHON_SIMPLE = 3
KIHON_COUNT  = 12

var array<int> KIHON = array.from(9, 17, 26, 33, 42, 51, 65, 76, 129, 172, 226, 257)

//--- Is n a kihon suchi number, and which kind. The compound flag is a
//--- filter, not a separate list: false leaves only 9, 17 and 26.
f_kihonIs(int n, bool withCompound) =>
    int last = withCompound ? KIHON_COUNT : KIHON_SIMPLE
    bool hit = false
    for i = 0 to last - 1
        int k = array.get(KIHON, i)
        if k == n
            hit := true
            break
        if k > n                             // ascending, so no point going on
            break
    hit

//--- The last kihon number at or below n, or 0 below the first.
f_kihonAtOrBelow(int n, bool withCompound) =>
    int last = withCompound ? KIHON_COUNT : KIHON_SIMPLE
    int best = 0
    for i = 0 to last - 1
        int k = array.get(KIHON, i)
        if k <= n
            best := k
        else
            break
    best

//--- The next kihon number strictly above n, or 0 past the end. Strictly
//--- above, so standing ON 26 tells you 33 is next rather than repeating
//--- the number you are already on.
f_kihonNext(int n, bool withCompound) =>
    int last = withCompound ? KIHON_COUNT : KIHON_SIMPLE
    int nx = 0
    for i = 0 to last - 1
        int k = array.get(KIHON, i)
        if k > n
            nx := k
            break
    nx

//--- The last number of the ACTIVE list: 257 with the compounds on, 26 with
//--- them off. "Past 257" has to become "past 26" when 33 and up are hidden.
f_kihonLast(bool withCompound) =>
    array.get(KIHON, (withCompound ? KIHON_COUNT : KIHON_SIMPLE) - 1)

//--- Signed distance to the NEAREST kihon number. 0 means n is one,
//--- negative means the number is still ahead (7 -> -2), positive means it
//--- has just gone by (11 -> +2). Nearest, not next, because a turn that was
//--- due at 26 is not cancelled by the candle after it.
f_kihonOffset(int n, bool withCompound) =>
    int last = withCompound ? KIHON_COUNT : KIHON_SIMPLE
    int best = n - array.get(KIHON, 0)
    for i = 1 to last - 1
        int d  = n - array.get(KIHON, i)
        int ad = int(math.abs(d))
        int ab = int(math.abs(best))
        if ad < ab
            best := d
    best

//+------------------------------------------------------------------+
//|  INPUTS                                                          |
//+------------------------------------------------------------------+
string G_GRID  = "Grid"
string G_LBL   = "Labels"
string G_PO3   = "PO3 levels to show"
string G_CLK   = "Candle countdown"
string G_SESS  = "Session timer"
string G_CNT   = "Candle count"
string G_KIH   = "Kihon suchi"
string G_PAN   = "Kihon count panel"
string G_SEG   = "Kihon segment panel"
string G_SCH   = "Kihon schedule panel"
string G_LIQ   = "Unraided liquidity"
string G_FVG   = "Fair value gaps"

//--- Grid -----------------------------------------------------------
scaleDiv = input.float(1.0, "Scale divisor", minval = 0.0000001, step = 1.0,
     group = G_GRID,
     tooltip = "1 gives whole numbers and is the default: gold levels land on 4374, 4455, 4536 and so on, the sheet's raw figures with nothing to divide. 100 gives the workbook's two-decimal gold form (2799.36, 3542.94). The two agree - the scale 1 grid is exactly the whole-number subset of the scale 100 grid.")
eachSide = input.int(3, "Levels each side of price", minval = 1, maxval = 100,
     group = G_GRID)

//--- Labels ---------------------------------------------------------
showLabels  = input.bool(true, "Write the PO3 number on each line", group = G_LBL)
labelMinPO3 = input.int(3, "Label only levels of PO3 >= this", minval = 1, maxval = 19683,
     group = G_LBL,
     tooltip = "3 by default, which leaves the optional 1 grid unlabelled: its levels are a dollar apart and a column of 1s on top of each other says nothing the line spacing does not.")
labelSizeIn = input.string("Tiny", "Label text size",
     options = ["Tiny", "Small", "Normal", "Large", "Huge"], group = G_LBL)
labelShift  = input.int(5, "Label shift right, in bars", minval = 0, maxval = 100,
     group = G_LBL,
     tooltip = "Five bars out by default, so the numbers sit in the chart margin clear of the developing candle rather than on top of it.")
labelSameColor = input.bool(false, "Label in the level's own colour", group = G_LBL,
     tooltip = "Off: every label is one colour, so the numbers read at a glance whatever grid they name, and the line keeps the grid's colour. On: each label takes its level's colour, as before v1.52.")
labelColor     = input.color(color.yellow, "Label colour", group = G_LBL)

//--- PO3 grids. The fine grids - 1, 3, 9 and 27 - are off by default, for
//--- a quieter chart that opens on 81 and up. 1 is finer than the rest and
//--- is M1 only: at scale 1 it is every whole number, and above M1 a dollar
//--- grid is a rounding error rather than a subdivision you can see.
use_1     = input.bool(false, "1      - show (M1 only)", group = G_PO3)
col_1     = input.color(color.new(#303030, 0), "1      - colour", group = G_PO3)
use_3     = input.bool(false, "3      - show", group = G_PO3)
col_3     = input.color(color.gray, "3      - colour", group = G_PO3)
use_9     = input.bool(false, "9      - show", group = G_PO3)
col_9     = input.color(color.new(#404040, 0), "9      - colour", group = G_PO3)
use_27    = input.bool(false, "27     - show", group = G_PO3)
col_27    = input.color(color.new(#5F9EA0, 0), "27     - colour", group = G_PO3)
use_81    = input.bool(true, "81     - show", group = G_PO3)
col_81    = input.color(color.new(#4682B4, 0), "81     - colour", group = G_PO3)
use_243   = input.bool(true, "243    - show", group = G_PO3)
col_243   = input.color(color.new(#3CB371, 0), "243    - colour", group = G_PO3)
use_729   = input.bool(true, "729    - show", group = G_PO3)
col_729   = input.color(color.new(#FF8C00, 0), "729    - colour", group = G_PO3)
use_2187  = input.bool(true, "2187   - show", group = G_PO3)
col_2187  = input.color(color.new(#DAA520, 0), "2187   - colour", group = G_PO3)
use_6561  = input.bool(true, "6561   - show", group = G_PO3)
col_6561  = input.color(color.new(#FF4500, 0), "6561   - colour", group = G_PO3)
use_19683 = input.bool(true, "19683  - show", group = G_PO3)
col_19683 = input.color(color.new(#DC143C, 0), "19683  - colour", group = G_PO3)

//--- Candle countdown -----------------------------------------------
showClock    = input.bool(true, "Show time left on the current candle", group = G_CLK)
clockShift   = input.int(1, "Bars right of the developing candle", minval = 0, maxval = 50, group = G_CLK)
